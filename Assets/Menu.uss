.root-container {
    flex-direction: column;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
}

.screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
}

.unity-disabled {
    display: none;
}

.screen--menu {
    flex-direction: row;
    background-color: rgb(30, 58, 30);
}

.menu-left {
    width: 45%;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 36px 32px;
    background-color: rgb(30, 58, 30);
}

.menu-right {
    flex: 1;
    background-color: rgb(76, 175, 80);
}

.logo-container {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 52px;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.logo-icon {
    font-size: 40px;
    margin-right: 8px;
    -unity-text-align: lower-center;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.logo-text {
    -unity-font-definition: url('project://database/Assets/Fonts/PressStart2P.asset');
    font-size: 28px;
    color: rgb(232, 200, 138);
    white-space: normal;
    text-shadow: 3px 3px 0 rgb(92, 51, 23), 5px 5px 0 rgba(0, 0, 0, 0.6);
    -unity-text-align: upper-left;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.menu-buttons {
    flex-direction: column;
    align-items: flex-start;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.btn-menu {
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-BoldItalic.asset');
    font-size: 20px;
    color: rgb(245, 240, 224);
    background-color: rgb(92, 51, 23);
    border-color: rgb(212, 169, 106);
    border-width: 3px;
    border-radius: 30px;
    padding: 14px 60px;
    margin-bottom: 16px;
    cursor: link;
    transition: background-color 0.15s ease, scale 0.15s ease;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.btn-menu:hover {
    background-color: rgb(122, 74, 42);
    scale: 1.04 1.04;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.btn-menu:active {
    scale: 0.98 0.98;
    background-color: rgb(92, 51, 23);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.screen--saves {
    flex-direction: column;
    background-color: rgb(30, 58, 30);
    padding: 24px 32px;
}

.saves-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.saves-logo {
    -unity-font-definition: url('project://database/Assets/Fonts/PressStart2P.asset');
    font-size: 14px;
    color: rgb(232, 200, 138);
    margin-right: 20px;
    flex-grow: 1;
}

.btn-back-sm {
    font-size: 12px;
    padding: 4px 14px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(212, 169, 106);
    background-color: rgb(92, 51, 23);
    color: rgb(245, 240, 224);
    cursor: link;
    transition: background-color 0.15s ease;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.btn-back-sm:hover {
    background-color: rgb(122, 74, 42);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.slots-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
}

.slot-card {
    width: 28%;
    margin: 1%;
    background-color: rgb(92, 51, 23);
    border-color: rgb(212, 169, 106);
    border-width: 3px;
    border-radius: 12px;
    padding: 20px 16px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    cursor: link;
    transition: border-color 0.15s ease, translate 0.15s ease;
}

.slot-card:hover {
    border-color: rgb(232, 200, 138);
    translate: 0 -3px;
}

.slot-card--empty {
    opacity: 0.7;
}

.slot-icon {
    font-size: 36px;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.slot-icon--empty {
    opacity: 0.4;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.slot-name {
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-BoldItalic.asset');
    font-size: 14px;
    color: rgb(245, 240, 224);
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.slot-name--empty {
    color: rgb(196, 147, 90);
    font-size: 13px;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.modal-box {
    background-color: rgb(92, 51, 23);
    border-color: rgb(212, 169, 106);
    border-width: 3px;
    border-radius: 14px;
    padding: 28px;
    width: 340px;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
}

.modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background-color: transparent;
    border-width: 0;
    color: rgb(245, 240, 224);
    font-size: 16px;
    cursor: link;
    padding: 0;
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Bold.asset');
}

.modal-close:hover {
    color: rgb(240, 208, 96);
}

.modal-icon {
    font-size: 80px;
    align-self: center;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.modal-title {
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-BoldItalic.asset');
    font-size: 22px;
    color: rgb(245, 240, 224);
    margin-bottom: 20px;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.modal-rename-field {
    width: 100%;
    margin-bottom: 12px;
    background-color: rgb(30, 58, 30);
    border-color: rgb(212, 169, 106);
    border-width: 2px;
    border-radius: 8px;
    color: rgb(245, 240, 224);
    font-size: 14px;
    padding: 8px 12px;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.modal-rename-field > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    color: rgb(245, 240, 224);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    width: 100%;
    flex-wrap: wrap;
    -unity-font: url('project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=e2ba20d7d14437747a1baa56fdb039d3&type=3#NotInter-Regular');
}

.btn-sm {
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Bold.asset');
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(212, 169, 106);
    background-color: rgb(122, 74, 42);
    color: rgb(245, 240, 224);
    margin-left: 8px;
    margin-top: 6px;
    cursor: link;
    transition: background-color 0.1s ease;
}

.btn-sm:hover {
    background-color: rgb(196, 147, 90);
}

.btn-sm--play {
    background-color: rgb(61, 139, 61);
    border-color: rgb(76, 175, 80);
    font-size: 15px;
    padding: 10px 24px;
}

.btn-sm--play:hover {
    background-color: rgb(76, 175, 80);
}

.btn-sm--danger {
    border-color: rgb(231, 76, 60);
    color: rgb(255, 170, 170);
}

.btn-sm--danger:hover {
    background-color: rgba(231, 76, 60, 0.3);
}
