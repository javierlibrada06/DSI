/*  ╔══════════════════════════════════════════════════════════════╗
    ║  Roots of Life — MainMenu.uss                                ║
    ║  Paleta y tipografía de referencia:                          ║
    ║    dark-green  #1e3a1e   mid-green   #2d5a2d                 ║
    ║    light-green #3d8b3d   bright-green #4caf50                ║
    ║    brown       #5c3317   brown-mid    #7a4a2a                ║
    ║    brown-light #c4935a   sand         #d4a96a                ║
    ║    sand-light  #e8c88a   text-white   #f5f0e0                ║
    ║    text-gold   #f0d060                                       ║
    ╚══════════════════════════════════════════════════════════════╝ */


/* ─────────────────────────────────────────────
   RESET / BASE
   ───────────────────────────────────────────── */
.root-container {
    flex-direction: column;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
}


/* ─────────────────────────────────────────────
   PANTALLAS  (visibilidad gestionada desde C#)
   ───────────────────────────────────────────── */
.screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
}

/* unity-disabled oculta el elemento sin quitarlo del árbol */
.unity-disabled {
    display: none;
}


/* ─────────────────────────────────────────────
   MENÚ PRINCIPAL
   ───────────────────────────────────────────── */
.screen--menu {
    flex-direction: row;
    background-color: #1e3a1e;
}

/* Mitad izquierda oscura */
.menu-left {
    width: 45%;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 36px 32px;
    background-color: #1e3a1e;
}

/* Mitad derecha verde viva (efecto diagonal del PDF) */
.menu-right {
    flex: 1;
    background-color: #4caf50;
    /* La diagonal se consigue con un clip en código o con un borde
       alternativo; en USS puro usamos un borde izquierdo inclinado
       simulado con border-left muy grueso y color transparente. */
}

/* ── Logo ── */
.logo-container {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 52px;
}

.logo-icon {
    font-size: 40px;
    margin-right: 8px;
    -unity-text-align: lower-center;
}

.logo-text {
    /* Requiere fuente "Press Start 2P" registrada en el proyecto */
    -unity-font-definition: url("project://database/Assets/Fonts/PressStart2P.asset");
    font-size: 28px;
    color: #e8c88a;
    white-space: normal;
    /* sombra texto: UIToolkit usa text-shadow */
    text-shadow: 3px 3px 0 #5c3317, 5px 5px 0 rgba(0,0,0,0.6);
    -unity-text-align: upper-left;
}

/* ── Botones menú ── */
.menu-buttons {
    flex-direction: column;
    align-items: flex-start;
}

.btn-menu {
    /* Fuente: Nunito italic bold  */
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-BoldItalic.asset");
    font-size: 20px;
    color: #f5f0e0;
    background-color: #5c3317;
    border-color: #d4a96a;
    border-width: 3px;
    border-radius: 30px;
    padding: 14px 60px;
    margin-bottom: 16px;
    cursor: link;
    /* UIToolkit: transiciones solo en USS con pseudo-class */
    transition: background-color 0.15s ease, scale 0.15s ease;
}

.btn-menu:hover {
    background-color: #7a4a2a;
    scale: 1.04 1.04;
}

.btn-menu:active {
    scale: 0.98 0.98;
    background-color: #5c3317;
}


/* ─────────────────────────────────────────────
   PANTALLA DE PARTIDAS GUARDADAS
   ───────────────────────────────────────────── */
.screen--saves {
    flex-direction: column;
    background-color: #1e3a1e;
    padding: 24px 32px;
}

/* Cabecera */
.saves-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.saves-logo {
    -unity-font-definition: url("project://database/Assets/Fonts/PressStart2P.asset");
    font-size: 14px;
    color: #e8c88a;
    margin-right: 20px;
    flex-grow: 1;
}

.btn-back-sm {
    font-size: 12px;
    padding: 4px 14px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #d4a96a;
    background-color: #5c3317;
    color: #f5f0e0;
    cursor: link;
    transition: background-color 0.15s ease;
}

.btn-back-sm:hover {
    background-color: #7a4a2a;
}

/* Grid de slots */
.slots-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
}

/* Slot individual */
.slot-card {
    width: 28%;
    margin: 1%;
    background-color: #5c3317;
    border-color: #d4a96a;
    border-width: 3px;
    border-radius: 12px;
    padding: 20px 16px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    cursor: link;
    transition: border-color 0.15s ease, translate 0.15s ease;
}

.slot-card:hover {
    border-color: #e8c88a;
    translate: 0 -3px;
}

.slot-card--empty {
    opacity: 0.7;
}

.slot-icon {
    font-size: 36px;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.slot-icon--empty {
    opacity: 0.4;
}

.slot-name {
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-BoldItalic.asset");
    font-size: 14px;
    color: #f5f0e0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.slot-name--empty {
    color: #c4935a;
    font-size: 13px;
}


/* ─────────────────────────────────────────────
   MODAL — OPCIONES DE SLOT
   ───────────────────────────────────────────── */
.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    /* z-index alto para quedar encima de todo */
    /* UIToolkit respeta el orden en el árbol; colocar al final del root */
}

.modal-box {
    background-color: #5c3317;
    border-color: #d4a96a;
    border-width: 3px;
    border-radius: 14px;
    padding: 28px;
    width: 340px;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
}

.modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background-color: transparent;
    border-width: 0;
    color: #f5f0e0;
    font-size: 16px;
    cursor: link;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-Bold.asset");
}

.modal-close:hover {
    color: #f0d060;
}

.modal-icon {
    font-size: 80px;
    align-self: center;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.modal-title {
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-BoldItalic.asset");
    font-size: 22px;
    color: #f5f0e0;
    margin-bottom: 20px;
}

.modal-rename-field {
    width: 100%;
    margin-bottom: 12px;
    background-color: #1e3a1e;
    border-color: #d4a96a;
    border-width: 2px;
    border-radius: 8px;
    color: #f5f0e0;
    font-size: 14px;
    padding: 8px 12px;
}

.modal-rename-field > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    color: #f5f0e0;
}

.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    width: 100%;
    flex-wrap: wrap;
}

/* ── Botones pequeños del modal ── */
.btn-sm {
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-Bold.asset");
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #d4a96a;
    background-color: #7a4a2a;
    color: #f5f0e0;
    margin-left: 8px;
    margin-top: 6px;
    cursor: link;
    transition: background-color 0.1s ease;
}

.btn-sm:hover {
    background-color: #c4935a;
}

.btn-sm--play {
    background-color: #3d8b3d;
    border-color: #4caf50;
    font-size: 15px;
    padding: 10px 24px;
}

.btn-sm--play:hover {
    background-color: #4caf50;
}

.btn-sm--danger {
    border-color: #e74c3c;
    color: #ffaaaa;
}

.btn-sm--danger:hover {
    background-color: rgba(231, 76, 60, 0.3);
}
