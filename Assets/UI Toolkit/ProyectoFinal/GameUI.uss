.game-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(45, 90, 45);
}

.unity-disabled {
    display: none;
}

.topbar {
    flex-direction: row;
    height: 44px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 169, 106);
    flex-shrink: 0;
}

.tab {
    flex: 1;
    height: 100%;
    border-width: 0;
    border-radius: 0;
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-BoldItalic.asset');
    font-size: 13px;
    color: rgb(245, 240, 224);
    cursor: link;
    transition: background-color 0.15s ease;
    padding: 0;
    margin: 0;
    border-bottom-color: rgba(240, 208, 96, 0);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tab--mapa {
    background-color: rgb(92, 51, 23);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tab--inventario {
    background-color: rgb(196, 147, 90);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tab--enciclopedia {
    background-color: rgb(184, 128, 74);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tab--mejoras {
    background-color: rgb(168, 106, 58);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tab--ajustes {
    background-color: rgb(154, 92, 46);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tab--active {
    filter: ;
    border-bottom-width: 3px;
    border-bottom-color: rgb(240, 208, 96);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tab:hover {
    filter: ;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.game-content {
    flex-direction: row;
    flex: 1;
    overflow: hidden;
}

.tab-content {
    flex: 1;
    overflow: hidden;
}

.tab-content--active {
    display: flex;
}

.placeholder-label {
    color: rgb(232, 200, 138);
    font-size: 14px;
    padding: 24px;
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.side-panel {
    width: 260px;
    flex-shrink: 0;
    background-color: rgb(30, 58, 30);
    border-left-width: 2px;
    border-left-color: rgb(212, 169, 106);
    padding: 20px 16px;
    flex-direction: column;
    align-items: stretch;
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.panel-title {
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-BoldItalic.asset');
    font-size: 22px;
    color: rgb(245, 240, 224);
    -unity-text-align: upper-right;
    margin-bottom: 12px;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.panel-desc {
    font-size: 13px;
    color: rgb(245, 240, 224);
    white-space: normal;
    -unity-text-align: upper-left;
    line-height: 1.6;
    -unity-font: url('project://database/Assets/fonts/Nunito-VariableFont_wght.ttf?fileID=12800000&guid=6f590c70935960247890ca094bff7f7f&type=3#Nunito-VariableFont_wght');
}

.panel-back-btn {
    margin-top: auto;
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-BoldItalic.asset');
    font-size: 13px;
    color: rgb(245, 240, 224);
    background-color: rgb(92, 51, 23);
    border-color: rgb(212, 169, 106);
    border-width: 2px;
    border-radius: 20px;
    padding: 10px 20px;
    cursor: link;
    align-self: flex-end;
    transition: background-color 0.15s ease;
}

.panel-back-btn:hover {
    background-color: rgb(122, 74, 42);
}

.map-area {
    width: 100%;
    height: 100%;
    background-color: rgb(76, 175, 80);
    position: relative;
    cursor: pan;
    overflow: hidden;
}

.island {
    position: absolute;
    background-color: rgb(212, 169, 106);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    cursor: link;
    transition: scale 0.2s ease;
}

.island:hover {
    scale: 1.05 1.05;
    border-color: rgb(255, 255, 255);
}

.island--selected {
    border-color: rgb(240, 208, 96);
    border-width: 4px;
}

.island--central {
    width: 200px;
    height: 160px;
    top: 80px;
    left: 180px;
}

.island--oeste {
    width: 130px;
    height: 120px;
    top: 160px;
    left: 30px;
}

.island--este {
    width: 100px;
    height: 150px;
    top: 50px;
    left: 400px;
}

.island-label {
    font-size: 12px;
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Bold.asset');
    color: rgb(92, 51, 23);
    -unity-text-align: middle-center;
}

.inv-area {
    padding: 16px;
    flex-direction: column;
    align-items: flex-start;
}

.inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 414px;
}

.inv-slot {
    width: 64px;
    height: 64px;
    background-color: rgb(212, 169, 106);
    border-width: 2px;
    border-color: rgb(122, 74, 42);
    border-radius: 8px;
    margin: 3px;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: link;
    transition: border-color 0.1s ease;
    overflow: hidden;
}

.inv-slot:hover {
    border-color: rgb(240, 208, 96);
}

.inv-slot--selected {
    border-style: dashed;
    border-color: rgb(245, 240, 224);
    background-color: rgb(196, 147, 90);
}

.inv-slot--empty {
    opacity: 0.6;
}

.inv-slot--drag-over {
    background-color: rgb(61, 139, 61);
    border-color: rgb(240, 208, 96);
}

.inv-slot > .item-icon {
    font-size: 26px;
    -unity-text-align: middle-center;
}

.item-count {
    position: absolute;
    bottom: 3px;
    right: 5px;
    font-size: 11px;
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Bold.asset');
    color: rgb(92, 51, 23);
    background-color: rgba(255, 255, 255, 0.8);
    padding: 0 3px;
    border-radius: 4px;
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.inv-drag-ghost {
    position: absolute;
    width: 64px;
    height: 64px;
    background-color: rgba(212, 169, 106, 0.8);
    border-width: 2px;
    border-color: rgb(240, 208, 96);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
}

.inv-drag-ghost > .item-icon {
    font-size: 26px;
    -unity-text-align: middle-center;
}

.upg-area {
    padding: 20px;
    flex-direction: column;
    align-items: flex-start;
}

.tool-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.tool-icon {
    width: 56px;
    height: 56px;
    background-color: rgb(92, 51, 23);
    border-width: 3px;
    border-color: rgb(212, 169, 106);
    border-radius: 8px;
    font-size: 28px;
    -unity-text-align: middle-center;
    cursor: link;
    transition: background-color 0.1s ease, border-style 0.1s ease;
    padding: 0;
    margin-right: 12px;
    flex-shrink: 0;
}

.tool-icon:hover {
    background-color: rgb(122, 74, 42);
    border-style: dashed;
    border-color: rgb(245, 240, 224);
}

.tool-icon--selected {
    background-color: rgb(122, 74, 42);
    border-style: dashed;
    border-color: rgb(245, 240, 224);
}

.level-bars {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.level-bar {
    width: 48px;
    height: 30px;
    background-color: rgb(212, 169, 106);
    border-width: 2px;
    border-color: rgb(122, 74, 42);
    margin-right: 4px;
    position: relative;
    align-items: flex-start;
    justify-content: flex-end;
}

.level-bar--active {
    background-color: rgb(232, 200, 138);
}

.level-bar--current {
    border-color: rgb(245, 240, 224);
    border-width: 2px;
}

.bar-num {
    position: absolute;
    bottom: 2px;
    left: 4px;
    font-size: 10px;
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Bold.asset');
    color: rgb(92, 51, 23);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tool-info {
    flex-direction: column;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tool-name {
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Bold.asset');
    font-size: 16px;
    color: rgb(245, 240, 224);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tool-lvl {
    font-size: 12px;
    color: rgb(232, 200, 138);
    margin-top: 2px;
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.upg-info {
    flex-direction: column;
    margin-top: 12px;
    border-top-width: 1px;
    border-top-color: rgb(212, 169, 106);
    padding-top: 12px;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.upg-level {
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Bold.asset');
    font-size: 18px;
    color: rgb(245, 240, 224);
    margin-bottom: 6px;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.upg-next {
    font-size: 12px;
    color: rgb(232, 200, 138);
    margin-bottom: 4px;
    white-space: normal;
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.upg-capacity {
    font-size: 12px;
    color: rgb(245, 240, 224);
    margin-bottom: 2px;
    -unity-font: url('project://database/Assets/fonts/Nunito-VariableFont_wght.ttf?fileID=12800000&guid=6f590c70935960247890ca094bff7f7f&type=3#Nunito-VariableFont_wght');
}

.btn-upgrade {
    margin-top: 8px;
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Bold.asset');
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(212, 169, 106);
    background-color: rgb(61, 139, 61);
    color: rgb(245, 240, 224);
    cursor: link;
    transition: background-color 0.15s ease;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.btn-upgrade:hover {
    background-color: rgb(76, 175, 80);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.upg-max-label {
    color: rgb(240, 208, 96);
    font-size: 12px;
    margin-top: 8px;
    white-space: normal;
    -unity-font: url('project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=e2ba20d7d14437747a1baa56fdb039d3&type=3#NotInter-Regular');
}

.settings-area {
    padding: 32px;
    flex-direction: column;
    align-items: flex-start;
}

.setting-row {
    flex-direction: column;
    margin-bottom: 28px;
}

.setting-label {
    font-size: 13px;
    color: rgb(232, 200, 138);
    font-weight: 600;
    margin-bottom: 6px;
}

.setting-slider-row {
    flex-direction: row;
    align-items: center;
}

.setting-slider {
    width: 320px;
    margin-right: 12px;
}

.setting-slider > .unity-base-slider__tracker {
    background-color: rgb(122, 74, 42);
    border-radius: 4px;
    height: 6px;
}

.setting-slider > .unity-base-slider__drag-container > .unity-base-slider__tracker {
    background-color: rgb(196, 147, 90);
}

.setting-slider > .unity-base-slider__drag-container > .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(196, 147, 90);
    border-width: 2px;
    border-color: rgb(212, 169, 106);
    margin-top: -6px;
}

.setting-slider > .unity-base-slider__drag-container > .unity-base-slider__dragger:hover {
    background-color: rgb(232, 200, 138);
}

.setting-value {
    font-size: 13px;
    color: rgb(245, 240, 224);
    min-width: 28px;
    -unity-text-align: middle-left;
}
