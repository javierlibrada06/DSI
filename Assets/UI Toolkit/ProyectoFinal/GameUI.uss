/*  ╔══════════════════════════════════════════════════════════════╗
    ║  Roots of Life — GameUI.uss                                  ║
    ║  Paleta:                                                     ║
    ║    dark-green  #1e3a1e   mid-green    #2d5a2d               ║
    ║    light-green #3d8b3d   bright-green #4caf50               ║
    ║    brown       #5c3317   brown-mid    #7a4a2a               ║
    ║    brown-light #c4935a   sand         #d4a96a               ║
    ║    sand-light  #e8c88a   text-white   #f5f0e0               ║
    ║    text-gold   #f0d060                                      ║
    ╚══════════════════════════════════════════════════════════════╝ */


/* ═══════════════════════════════════════════════
   ROOT
   ═══════════════════════════════════════════════ */
.game-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #2d5a2d;
}

/* Oculta cualquier elemento marcado con esta clase */
.unity-disabled {
    display: none;
}


/* ═══════════════════════════════════════════════
   BARRA DE PESTAÑAS
   ═══════════════════════════════════════════════ */
.topbar {
    flex-direction: row;
    height: 44px;
    border-bottom-width: 2px;
    border-bottom-color: #d4a96a;
    flex-shrink: 0;
}

.tab {
    flex: 1;
    height: 100%;
    border-width: 0;
    border-radius: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-BoldItalic.asset");
    font-size: 13px;
    color: #f5f0e0;
    cursor: link;
    transition: background-color 0.15s ease;
    /* Eliminar padding/margen interno por defecto de Button */
    padding: 0;
    margin: 0;
}

/* Colores escalonados igual que el PDF */
.tab--mapa         { background-color: #5c3317; }
.tab--inventario   { background-color: #c4935a; }
.tab--enciclopedia { background-color: #b8804a; }
.tab--mejoras      { background-color: #a86a3a; }
.tab--ajustes      { background-color: #9a5c2e; }

.tab--active {
    filter: brightness(1.25);
    border-bottom-width: 3px;
    border-bottom-color: #f0d060;
}

.tab:hover {
    filter: brightness(1.1);
}


/* ═══════════════════════════════════════════════
   ÁREA DE CONTENIDO (main-area + side-panel)
   ═══════════════════════════════════════════════ */
.game-content {
    flex-direction: row;
    flex: 1;
    overflow: hidden;
}

/* Cada pestaña ocupa todo el espacio de main-area */
.tab-content {
    flex: 1;
    overflow: hidden;
}

.tab-content--active {
    display: flex;
}

.placeholder-label {
    color: #e8c88a;
    font-size: 14px;
    padding: 24px;
}


/* ═══════════════════════════════════════════════
   PANEL LATERAL DERECHO
   ═══════════════════════════════════════════════ */
.side-panel {
    width: 260px;
    flex-shrink: 0;
    background-color: #1e3a1e;
    border-left-width: 2px;
    border-left-color: #d4a96a;
    padding: 20px 16px;
    flex-direction: column;
    align-items: stretch;
}

.panel-title {
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-BoldItalic.asset");
    font-size: 22px;
    color: #f5f0e0;
    -unity-text-align: upper-right;
    margin-bottom: 12px;
}

.panel-desc {
    font-size: 13px;
    color: #f5f0e0;
    white-space: normal;
    -unity-text-align: upper-left;
    line-height: 1.6;
}

/* Botón "Volver" del mapa */
.panel-back-btn {
    margin-top: auto;
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-BoldItalic.asset");
    font-size: 13px;
    color: #f5f0e0;
    background-color: #5c3317;
    border-color: #d4a96a;
    border-width: 2px;
    border-radius: 20px;
    padding: 10px 20px;
    cursor: link;
    align-self: flex-end;
    transition: background-color 0.15s ease;
}

.panel-back-btn:hover {
    background-color: #7a4a2a;
}


/* ═══════════════════════════════════════════════
   MAPA
   ═══════════════════════════════════════════════ */
.map-area {
    width: 100%;
    height: 100%;
    background-color: #4caf50;
    position: relative;
    /* El cursor "mano" en modo drag se pone por código */
    cursor: pan;
    overflow: hidden;
}

/* Islas: posición absoluta gestionada desde C# o USS */
.island {
    position: absolute;
    background-color: #d4a96a;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    cursor: link;
    transition: scale 0.2s ease;
}

.island:hover {
    scale: 1.05 1.05;
    border-color: rgba(255, 255, 255, 1.0);
}

.island--selected {
    border-color: #f0d060;
    border-width: 4px;
}

/* Tamaños y posiciones de cada isla */
.island--central {
    width: 200px;
    height: 160px;
    top:  80px;
    left: 180px;
}

.island--oeste {
    width:  130px;
    height: 120px;
    top:  160px;
    left:  30px;
}

.island--este {
    width:  100px;
    height: 150px;
    top:   50px;
    left: 400px;
}

.island-label {
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-Bold.asset");
    color: #5c3317;
    -unity-text-align: middle-center;
}


/* ═══════════════════════════════════════════════
   INVENTARIO
   ═══════════════════════════════════════════════ */
.inv-area {
    padding: 16px;
    flex-direction: column;
    align-items: flex-start;
}

/* Grid 6 columnas */
.inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 414px;   /* 6 × 64px + 5 × 6px gap */
}

.inv-slot {
    width: 64px;
    height: 64px;
    background-color: #d4a96a;
    border-width: 2px;
    border-color: #7a4a2a;
    border-radius: 8px;
    margin: 3px;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: link;
    transition: border-color 0.1s ease;
    overflow: hidden;
}

.inv-slot:hover {
    border-color: #f0d060;
}

/* Slot seleccionado (primer clic para iniciar drag en código) */
.inv-slot--selected {
    border-style: dashed;
    border-color: #f5f0e0;
    background-color: #c4935a;
}

/* Slot vacío: ligera opacidad */
.inv-slot--empty {
    opacity: 0.6;
}

/* Resaltado durante drag-over */
.inv-slot--drag-over {
    background-color: #3d8b3d;
    border-color: #f0d060;
}

/* El icono del ítem (Label o Image dentro del slot) */
.inv-slot > .item-icon {
    font-size: 26px;
    -unity-text-align: middle-center;
}

/* Contador de cantidad — esquina inferior derecha */
.item-count {
    position: absolute;
    bottom: 3px;
    right: 5px;
    font-size: 11px;
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-Bold.asset");
    color: #5c3317;
    background-color: rgba(255, 255, 255, 0.8);
    padding: 0 3px;
    border-radius: 4px;
}

/* Elemento fantasma que sigue al cursor durante el drag */
.inv-drag-ghost {
    position: absolute;
    width: 64px;
    height: 64px;
    background-color: rgba(212, 169, 106, 0.8);
    border-width: 2px;
    border-color: #f0d060;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    /* Posición controlada por código con .style.left / .style.top */
}

.inv-drag-ghost > .item-icon {
    font-size: 26px;
    -unity-text-align: middle-center;
}


/* ═══════════════════════════════════════════════
   MEJORAS
   ═══════════════════════════════════════════════ */
.upg-area {
    padding: 20px;
    flex-direction: column;
    align-items: flex-start;
}

/* Fila de herramienta */
.tool-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

/* Icono / botón de herramienta */
.tool-icon {
    width: 56px;
    height: 56px;
    background-color: #5c3317;
    border-width: 3px;
    border-color: #d4a96a;
    border-radius: 8px;
    font-size: 28px;
    -unity-text-align: middle-center;
    cursor: link;
    transition: background-color 0.1s ease, border-style 0.1s ease;
    padding: 0;
    margin-right: 12px;
    flex-shrink: 0;
}

.tool-icon:hover,
.tool-icon--selected {
    background-color: #7a4a2a;
    border-style: dashed;
    border-color: #f5f0e0;
}

/* Contenedor de las 5 barras */
.level-bars {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

/* Barra individual */
.level-bar {
    width: 48px;
    height: 30px;
    background-color: #d4a96a;
    border-width: 2px;
    border-color: #7a4a2a;
    margin-right: 4px;
    position: relative;
    align-items: flex-start;
    justify-content: flex-end;
}

.level-bar--active {
    background-color: #e8c88a;
}

/* Barra del nivel actual: borde blanco */
.level-bar--current {
    border-color: #f5f0e0;
    border-width: 2px;
}

.bar-num {
    position: absolute;
    bottom: 2px;
    left: 4px;
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-Bold.asset");
    color: #5c3317;
}

/* Nombre y nivel de la herramienta */
.tool-info {
    flex-direction: column;
}

.tool-name {
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-Bold.asset");
    font-size: 16px;
    color: #f5f0e0;
}

.tool-lvl {
    font-size: 12px;
    color: #e8c88a;
    margin-top: 2px;
}

/* ── Bloque info upgrade en el side panel ── */
.upg-info {
    flex-direction: column;
    margin-top: 12px;
    border-top-width: 1px;
    border-top-color: #d4a96a;
    padding-top: 12px;
}

.upg-level {
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-Bold.asset");
    font-size: 18px;
    color: #f5f0e0;
    margin-bottom: 6px;
}

.upg-next {
    font-size: 12px;
    color: #e8c88a;
    margin-bottom: 4px;
    white-space: normal;
}

.upg-capacity {
    font-size: 12px;
    color: #f5f0e0;
    margin-bottom: 2px;
}

.btn-upgrade {
    margin-top: 8px;
    -unity-font-definition: url("project://database/Assets/Fonts/Nunito-Bold.asset");
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #d4a96a;
    background-color: #3d8b3d;
    color: #f5f0e0;
    cursor: link;
    transition: background-color 0.15s ease;
}

.btn-upgrade:hover {
    background-color: #4caf50;
}

.upg-max-label {
    color: #f0d060;
    font-size: 12px;
    margin-top: 8px;
    white-space: normal;
}


/* ═══════════════════════════════════════════════
   AJUSTES
   ═══════════════════════════════════════════════ */
.settings-area {
    padding: 32px;
    flex-direction: column;
    align-items: flex-start;
}

.setting-row {
    flex-direction: column;
    margin-bottom: 28px;
}

.setting-label {
    font-size: 13px;
    color: #e8c88a;
    font-weight: 600;
    margin-bottom: 6px;
}

.setting-slider-row {
    flex-direction: row;
    align-items: center;
}

/* Slider — se estiliza la pista y el thumb */
.setting-slider {
    width: 320px;
    margin-right: 12px;
}

/* Pista */
.setting-slider > .unity-base-slider__tracker {
    background-color: #7a4a2a;
    border-radius: 4px;
    height: 6px;
}

/* Relleno izquierdo (progreso) */
.setting-slider > .unity-base-slider__drag-container
                > .unity-base-slider__tracker {
    background-color: #c4935a;
}

/* Thumb (círculo) */
.setting-slider > .unity-base-slider__drag-container
                > .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: #c4935a;
    border-width: 2px;
    border-color: #d4a96a;
    margin-top: -6px;
}

.setting-slider > .unity-base-slider__drag-container
                > .unity-base-slider__dragger:hover {
    background-color: #e8c88a;
}

.setting-value {
    font-size: 13px;
    color: #f5f0e0;
    min-width: 28px;
    -unity-text-align: middle-left;
}
