.game-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(30, 58, 30);
    color: rgb(245, 240, 224);
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Bold.asset');
}

.unity-disabled {
    display: none;
}

.topbar {
    flex-direction: row;
    height: 60px;
    background-color: rgb(92, 51, 23);
    border-bottom-width: 3px;
    border-bottom-color: rgb(212, 169, 106);
    padding-left: 20px;
    padding-right: 20px;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.tab {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    color: rgb(196, 147, 90);
    font-size: 16px;
    margin-top: 8px;
    transition: background-color 0.2s ease, color 0.2s ease;
}

.tab:hover {
    background-color: rgba(212, 169, 106, 0.2);
    color: rgb(245, 240, 224);
}

.tab--active {
    background-color: rgb(30, 58, 30);
    color: rgb(240, 208, 96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-color: rgb(212, 169, 106);
}

.game-content {
    flex-direction: row;
    flex-grow: 1;
    padding: 20px;
}

.tab-content {
    flex-grow: 1;
    margin-right: 20px;
}

.map-area {
    flex-grow: 1;
    background-color: rgb(45, 90, 45);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
}

.island {
    position: absolute;
    background-color: rgb(212, 169, 106);
    border-radius: 50%;
    border-width: 4px;
    border-color: rgb(92, 51, 23);
    align-items: center;
    justify-content: center;
    padding: 10px;
}

.island--central {
    top: 40%;
    left: 40%;
    width: 120px;
    height: 120px;
    background-color: rgb(232, 200, 138);
}

.island--oeste {
    top: 20%;
    left: 15%;
    width: 90px;
    height: 90px;
}

.island--este {
    top: 60%;
    left: 70%;
    width: 100px;
    height: 100px;
}

.island-label {
    color: rgb(92, 51, 23);
    -unity-font-style: bold;
    font-size: 14px;
}

.inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.inv-slot {
    width: 15%;
    aspect-ratio: 1;
    margin: 0.8%;
    background-color: rgb(45, 90, 45);
    border-width: 2px;
    border-color: rgb(61, 139, 61);
    border-radius: 8px;
}

.inv-slot:hover {
    border-color: rgb(240, 208, 96);
    background-color: rgb(61, 139, 61);
}

.upg-area {
    flex-direction: column;
}

.tool-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(45, 90, 45);
    margin-bottom: 12px;
    padding: 10px;
    border-radius: 12px;
}

.tool-icon {
    width: 60px;
    height: 60px;
    font-size: 30px;
    background-color: rgb(92, 51, 23);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(212, 169, 106);
}

.level-bars {
    flex-direction: row;
    margin-left: 15px;
    flex-grow: 1;
}

.level-bar {
    width: 30px;
    height: 40px;
    background-color: rgb(30, 58, 30);
    margin-right: 4px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.level-bar--active {
    background-color: rgb(76, 175, 80);
}

.level-bar--current {
    border-width: 2px;
    border-color: rgb(240, 208, 96);
}

.bar-num {
    font-size: 10px;
    color: rgba(245, 240, 224, 0.5);
}

.tool-info {
    width: 120px;
    margin-left: 15px;
}

.tool-name {
    font-size: 18px;
    color: rgb(245, 240, 224);
}

.tool-lvl {
    font-size: 12px;
    color: rgb(240, 208, 96);
}

.settings-area {
    padding: 20px;
}

.setting-row {
    margin-bottom: 25px;
}

.setting-label {
    font-size: 16px;
    margin-bottom: 8px;
}

.setting-slider-row {
    flex-direction: row;
    align-items: center;
}

.setting-slider {
    flex-grow: 1;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.setting-value {
    width: 40px;
    -unity-text-align: middle-right;
    color: rgb(240, 208, 96);
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.side-panel {
    width: 300px;
    background-color: rgb(92, 51, 23);
    border-width: 3px;
    border-color: rgb(212, 169, 106);
    border-radius: 15px;
    padding: 20px;
}

.panel-title {
    font-size: 22px;
    color: rgb(240, 208, 96);
    margin-bottom: 15px;
    -unity-font-definition: url('project://database/Assets/Fonts/PressStart2P.asset');
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.panel-desc {
    font-size: 14px;
    color: rgb(232, 200, 138);
    white-space: normal;
    margin-bottom: 20px;
    -unity-font: url('project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=e2ba20d7d14437747a1baa56fdb039d3&type=3#NotInter-Regular');
}

.btn-upgrade {
    background-color: rgb(61, 139, 61);
    border-color: rgb(76, 175, 80);
    color: rgb(245, 240, 224);
    padding: 12px;
    border-radius: 10px;
    margin-top: 15px;
    -unity-font: url('project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=e2ba20d7d14437747a1baa56fdb039d3&type=3#NotInter-Regular');
}

.btn-upgrade:hover {
    background-color: rgb(76, 175, 80);
    -unity-font: url('project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=e2ba20d7d14437747a1baa56fdb039d3&type=3#NotInter-Regular');
}

.upg-capacity {
    font-size: 13px;
    color: rgb(245, 240, 224);
    margin-bottom: 4px;
}
