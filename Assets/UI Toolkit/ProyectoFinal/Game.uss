.game-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(45, 90, 45);
}

.unity-disabled {
    display: none;
}

.topbar {
    flex-direction: row;
    height: 10%;
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 169, 106);
    flex-shrink: 0;
    width: 100%;
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.tab {
    flex: 1;
    height: 100%;
    border-width: 0;
    border-radius: 0;
    font-size: 32px;
    color: rgb(245, 240, 224);
    cursor: link;
    transition: background-color 0.15s ease;
    padding: 0;
    margin: 0;
    width: 100%;
    background-color: rgb(184, 128, 74);
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.tab--active {
    border-bottom-width: 0;
    border-bottom-color: rgb(240, 208, 96);
    font-size: 32px;
    background-color: rgb(92, 51, 23);
    color: rgb(212, 169, 106);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.tab:hover {
    font-size: 32px;
    background-color: rgb(168, 106, 58);
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.game-content {
    flex-direction: row;
    flex: 1;
    overflow: hidden;
    width: 100%;
    height: 90%;
}

.tab-content {
    flex: 1;
    overflow: hidden;
    width: 100%;
    height: 100%;
}

.tab-content--active {
    display: flex;
    width: 100%;
    height: 100%;
}

.placeholder-label {
    color: rgb(232, 200, 138);
    font-size: 32px;
    padding: 24px;
}

.side-panel {
    width: 30%;
    flex-shrink: 0;
    background-color: rgb(30, 58, 30);
    border-left-width: 2px;
    border-left-color: rgb(212, 169, 106);
    padding: 20px 16px;
    flex-direction: column;
    align-items: stretch;
    height: 100%;
}

.panel-title {
    font-size: 45px;
    color: rgb(245, 240, 224);
    -unity-text-align: middle-left;
    margin-bottom: 12px;
    width: 100%;
    height: 10%;
    -unity-font: url('project://database/Assets/fonts/Masterpiece.ttf?fileID=12800000&guid=fccdc64a1a3b70c48b476d0b5e09045c&type=3#Masterpiece');
}

.panel-desc {
    font-size: 24px;
    color: rgb(245, 240, 224);
    white-space: normal;
    -unity-text-align: upper-left;
    line-height: 1.6;
    width: 100%;
    height: 12%;
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.panel-back-btn {
    margin-top: auto;
    font-size: 24px;
    color: rgb(245, 240, 224);
    background-color: rgb(92, 51, 23);
    border-color: rgb(212, 169, 106);
    border-width: 2px;
    border-radius: 20px;
    padding: 10px 20px;
    cursor: link;
    align-self: flex-end;
    transition: background-color 0.15s ease;
    width: 30%;
    height: 5%;
    -unity-font: url('project://database/Assets/fonts/Nunito-Bold.ttf?fileID=12800000&guid=aaf51f1373e92b7419339058f80a581b&type=3#Nunito-Bold');
}

.panel-back-btn:hover {
    background-color: rgba(122, 74, 42, 0.9);
    width: 30%;
    height: 5%;
    font-size: 24px;
}

.map-area {
    width: 100%;
    height: 100%;
    background-color: rgb(76, 175, 80);
    position: relative;
    cursor: pan;
    overflow: hidden;
}

.island {
    position: absolute;
    background-color: rgb(212, 169, 106);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    cursor: link;
    transition: scale 0.2s ease;
    font-size: 32px;
}

.island:hover {
    scale: 1.05 1.05;
    border-color: rgb(255, 255, 255);
    font-size: 32px;
}

.island--selected {
    layers: 10;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-back;
    font-size: 32px;
}

.island--faded {
    opacity: 0;
}

.island--central {
    width: 200px;
    height: 160px;
    top: 80px;
    left: 180px;
    font-size: 32px;
}

.island--oeste {
    width: 130px;
    height: 120px;
    top: 160px;
    left: 30px;
}

.island--este {
    width: 100px;
    height: 150px;
    top: 50px;
    left: 400px;
}

.island-label {
    font-size: 45px;
    color: rgb(92, 51, 23);
    -unity-text-align: middle-center;
}

.inv-area {
    padding: 16px;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    height: 100%;
}

.inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 70%;
    height: 70%;
    align-self: center;
    justify-content: center;
    align-items: center;
    margin-top: 5%;
}

.inv-slot {
    width: 15%;
    height: 20%;
    background-color: rgb(212, 169, 106);
    border-width: 2px;
    border-color: rgb(122, 74, 42);
    border-radius: 8px;
    margin: 3px;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: link;
    transition: border-color 0.1s ease;
    overflow: hidden;
}

.inv-slot:hover {
    border-color: rgb(240, 208, 96);
    width: 15%;
    height: 20%;
}

.inv-slot--selected {
    border-style: dashed;
    border-color: rgb(245, 240, 224);
    background-color: rgb(196, 147, 90);
    width: 15%;
    height: 20%;
}

.inv-slot--empty {
    opacity: 0.6;
    width: 15%;
    height: 20%;
}

.inv-slot--drag-over {
    background-color: rgb(61, 139, 61);
    border-color: rgb(240, 208, 96);
    width: 15%;
    height: 20%;
}

.inv-slot > .item-icon {
    font-size: 26px;
    -unity-text-align: middle-center;
    width: 15%;
    height: 20%;
}

.item-count {
    position: absolute;
    bottom: 3px;
    right: 5px;
    font-size: 11px;
    color: rgb(92, 51, 23);
    background-color: rgba(255, 255, 255, 0.8);
    padding: 0 3px;
    border-radius: 4px;
    width: 20%;
    height: 20%;
}

.inv-drag-ghost {
    position: absolute;
    width: 64px;
    height: 64px;
    background-color: rgba(212, 169, 106, 0.8);
    border-width: 2px;
    border-color: rgb(240, 208, 96);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
}

.inv-drag-ghost > .item-icon {
    font-size: 26px;
    -unity-text-align: middle-center;
    width: 64px;
    height: 64px;
}

.upg-area {
    padding: 20px;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    height: 100%;
}

.tool-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    width: 100%;
    height: 15%;
}

.tool-icon {
    width: 8%;
    height: 80%;
    background-color: rgb(92, 51, 23);
    border-width: 3px;
    border-color: rgb(212, 169, 106);
    border-radius: 8px;
    font-size: 28px;
    -unity-text-align: middle-center;
    cursor: link;
    transition: background-color 0.1s ease, border-style 0.1s ease;
    padding: 0;
    margin-right: 12px;
    flex-shrink: 0;
}

.tool-icon:hover {
    background-color: rgb(122, 74, 42);
    border-style: dashed;
    border-color: rgb(245, 240, 224);
    width: 8%;
    height: 80%;
}

.tool-icon--selected {
    background-color: rgb(122, 74, 42);
    border-style: dashed;
    border-color: rgb(245, 240, 224);
    width: 8%;
    height: 80%;
}

.level-bars {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
    width: 30%;
    height: 60%;
}

.level-bar {
    width: 20%;
    height: 100%;
    background-color: rgb(212, 169, 106);
    border-width: 2px;
    border-color: rgb(122, 74, 42);
    margin-right: 4px;
    position: relative;
    align-items: flex-start;
    justify-content: flex-end;
}

.level-bar--active {
    background-color: rgb(232, 200, 138);
    width: 20%;
    height: 100%;
}

.level-bar--current {
    border-color: rgb(245, 240, 224);
    border-width: 2px;
    width: 20%;
    height: 100%;
}

.bar-num {
    position: absolute;
    bottom: 2px;
    left: 4px;
    font-size: 24px;
    color: rgb(92, 51, 23);
    width: 100%;
    height: 100%;
}

.tool-info {
    flex-direction: column;
    width: 30%;
    height: 50%;
}

.tool-name {
    font-size: 32px;
    color: rgb(245, 240, 224);
}

.tool-lvl {
    font-size: 24px;
    color: rgb(232, 200, 138);
    margin-top: 2px;
    -unity-font-style: normal;
}

.upg-info {
    flex-direction: column;
    margin-top: 10%;
    border-top-width: 1px;
    border-top-color: rgb(212, 169, 106);
    padding-top: 5%;
}

.upg-level {
    font-size: 32px;
    color: rgb(245, 240, 224);
    margin-bottom: 6px;
    width: 100%;
    height: 20%;
}

.upg-next {
    font-size: 24px;
    color: rgb(232, 200, 138);
    margin-bottom: 0;
    white-space: normal;
    width: 100%;
    height: 15%;
}

.upg-capacity {
    font-size: 20px;
    color: rgb(245, 240, 224);
    margin-bottom: 2px;
    width: 100%;
    height: 15%;
}

.btn-upgrade {
    margin-top: 2%;
    font-size: 24px;
    padding: 8px 14px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(212, 169, 106);
    background-color: rgb(61, 139, 61);
    color: rgb(245, 240, 224);
    cursor: link;
    transition: background-color 0.15s ease;
    width: 40%;
    height: 20%;
    align-self: center;
    padding-left: 5%;
    padding-right: 5%;
    padding-top: 5%;
    padding-bottom: 5%;
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    -unity-text-align: middle-center;
}

.btn-upgrade:hover {
    background-color: rgb(76, 175, 80);
}

.upg-max-label {
    color: rgb(240, 208, 96);
    font-size: 24px;
    margin-top: 3%;
    white-space: normal;
    width: 100%;
    height: 20%;
    padding-top: 3%;
}

.settings-area {
    padding: 32px;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    height: 100%;
}

.setting-row {
    flex-direction: column;
    margin-bottom: 28px;
    width: 100%;
    height: 15%;
}

.setting-label {
    font-size: 32px;
    color: rgb(255, 255, 255);
    font-weight: 600;
    margin-bottom: 6px;
    -unity-font-style: bold;
    width: 50%;
}

.setting-slider-row {
    flex-direction: row;
    align-items: center;
    width: 50%;
    height: 100%;
}

.setting-slider {
    width: 50%;
    margin-right: 12px;
    font-size: 24px;
    height: 100%;
}

.setting-slider > .unity-base-slider__tracker {
    background-color: rgb(122, 74, 42);
    border-radius: 4px;
    height: 6px;
}

.setting-slider > .unity-base-slider__drag-container > .unity-base-slider__tracker {
    background-color: rgb(196, 147, 90);
}

.setting-slider > .unity-base-slider__drag-container > .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(196, 147, 90);
    border-width: 2px;
    border-color: rgb(212, 169, 106);
    margin-top: -6px;
}

.setting-slider > .unity-base-slider__drag-container > .unity-base-slider__dragger:hover {
    background-color: rgb(232, 200, 138);
}

.setting-value {
    font-size: 24px;
    color: rgb(232, 200, 138);
    min-width: 28px;
    -unity-text-align: middle-left;
}

.inv-debug-bar {
    flex-direction: row;
    margin-bottom: 8px;
    align-self: center;
    margin-top: 12px;
}

.btn-add-item {
    background-color: rgb(61, 139, 61);
    color: rgb(245, 240, 224);
    border-width: 2px;
    border-color: rgb(212, 169, 106);
    border-radius: 16px;
    font-size: 22px;
    padding: 6px 20px;
    margin-right: 12px;
    cursor: link;
    transition: background-color 0.15s ease;
}

.btn-add-item:hover {
    background-color: rgb(76, 175, 80);
}
