.stat-container {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    background-color: rgb(40, 40, 40);
    border-radius: 6px;
    width: 100%;
    height: 100%;
}

.stat-label {
    color: white;
    margin-right: 10px;
    text: "hola, gay";
    width: 20%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 100%;
}

.stat-container-icon {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    background-color: rgb(40, 40, 40);
    border-radius: 6px;
    width: 100%;
    height: 100%;
}

.stat-icon {
    width: 20%;
    height: 100%;
    margin-right: 4px;
    background-image: url('project://database/Assets/images/star.png?fileID=2800000&guid=11990e6e55e3f8343b11d8a0d7d9977f&type=3#star');
    background-size: cover;
    transition: scale 0.2s;
    -unity-background-scale-mode: scale-to-fit;
}

.stat-icon:hover {
    scale: 1.2;
}

.stat-icon:active {
    scale: 0.9;
}

.copiar {
}
